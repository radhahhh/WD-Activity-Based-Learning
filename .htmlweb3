
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bus and Train Ticket Booking</title>
    <link rel="stylesheet" href="login.css">
</head>
<body>

    <header>
        <h1>Easy Travel Booking</h1>
        <p>Book Your Bus and Train Tickets Easily</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#booking">Book Ticket</a>
        <a href="#services">Services</a>
        <a href="#seats">Select Seats</a>
    </nav>

    <section id="home">
        <h2>Welcome to Easy Travel</h2>
        <p>Find buses and trains for your journey.</p>
    </section>

    <section id="booking">
        <h2>Book Your Ticket</h2>

        <form>
            <label>Travel Type:</label>
            <select required>
                <option value="">Select Travel Type</option>
                <option>Bus</option>
                <option>Train</option>
            </select>

            <label>Source:</label>
            <input type="text" placeholder="Enter Source" required>

            <label>Destination:</label>
            <input type="text" placeholder="Enter Destination" required>

            <label>Journey Date:</label>
            <input type="date" required>

            <label>Passenger Name:</label>
            <input type="text" placeholder="Enter Name" required>

            <label>Age:</label>
            <input type="number" min="1" max="120" required>

            <label>Gender:</label>
            <select required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
                <option>Prefer not to say</option>
            </select>

            <label>Number of Passengers:</label>
            <input type="number" min="1" max="6" required>

            <button type="submit">Search Tickets</button>
        </form>
    </section>

    <section id="services">
        <h2>Available Services</h2>

        <div class="cards">

            <div class="card">
                <h3>Express Bus</h3>
                <p>From: Hyderabad</p>
                <p>To: Bangalore</p>
                <p>Departure: 8:00 PM</p>
                <p>Fare: ₹800</p>
                <a href="#seats">Select Seat</a>
            </div>

            <div class="card">
                <h3>Superfast Train</h3>
                <p>From: Hyderabad</p>
                <p>To: Chennai</p>
                <p>Departure: 6:00 AM</p>
                <p>Fare: ₹500</p>
                <a href="#seats">Select Seat</a>
            </div>

            <div class="card">
                <h3>Luxury Bus</h3>
                <p>From: Hyderabad</p>
                <p>To: Vijayawada</p>
                <p>Departure: 10:00 AM</p>
                <p>Fare: ₹600</p>
                <a href="#seats">Select Seat</a>
            </div>

        </div>

        <h2>Ticket Fare Information</h2>

        <div class="table-container">
            <table>
                <tr>
                    <th>Service</th>
                    <th>Type</th>
                    <th>Departure</th>
                    <th>Fare</th>
                </tr>

                <tr>
                    <td>Express Bus</td>
                    <td>AC Sleeper</td>
                    <td>8:00 PM</td>
                    <td>₹800</td>
                </tr>

                <tr>
                    <td>Superfast Train</td>
                    <td>Sleeper</td>
                    <td>6:00 AM</td>
                    <td>₹500</td>
                </tr>

                <tr>
                    <td>Luxury Bus</td>
                    <td>AC Seater</td>
                    <td>10:00 AM</td>
                    <td>₹600</td>
                </tr>
            </table>
        </div>
    </section>

    <section id="seats">
        <h2>Select Your Seat</h2>
        <p>Choose your preferred seat:</p>

        <div class="seat-layout">
            <label><input type="checkbox"> A1</label>
            <label><input type="checkbox"> A2</label>
            <label><input type="checkbox"> A3</label>
            <label><input type="checkbox"> A4</label>

            <label><input type="checkbox"> B1</label>
            <label><input type="checkbox"> B2</label>
            <label><input type="checkbox"> B3</label>
            <label><input type="checkbox"> B4</label>

            <label><input type="checkbox"> C1</label>
            <label><input type="checkbox"> C2</label>
            <label><input type="checkbox"> C3</label>
            <label><input type="checkbox"> C4</label>
        </div>

        <button type="button">Confirm Booking</button>
    </section>

    <footer>
        <p>© 2026 Easy Travel Booking | All Rights Reserved</p>
    </footer>

</body>
</html>
