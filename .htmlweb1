
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foodie - Online Food Ordering</title>
    <link rel="stylesheet" href="slector.css">
</head>
<body>

    <!-- Navigation -->
    <header>
        <h1>🍔 Foodie</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#offers">Offers</a>
            <a href="#reviews">Reviews</a>
        </nav>
    </header>

    <!-- Home Section -->
    <section class="hero" id="home">
        <h2>Delicious Food, Delivered Fast!</h2>
        <p>Fresh, tasty and affordable food at your doorstep.</p>
        <a href="#menu" class="btn">Order Now</a>
    </section>

    <!-- Special Offers -->
    <section id="offers">
        <h2>Special Offers 🎉</h2>
        <div class="offer">
            Get 20% OFF on your first order!
        </div>
    </section>

    <!-- Food Menu -->
    <section id="menu">
        <h2>Our Popular Menu 🍕</h2>

        <div class="food-container">

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=500"
                     alt="Delicious pizza">
                <h3>Cheese Pizza</h3>
                <p>Cheesy and delicious pizza.</p>
                <h4>₹199</h4>
                <button onclick="alert('Pizza added to order!')">
                    Order Now
                </button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=500"
                     alt="Burger">
                <h3>Veg Burger</h3>
                <p>Crispy burger with fresh vegetables.</p>
                <h4>₹99</h4>
                <button onclick="alert('Burger added to order!')">
                    Order Now
                </button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=500"
                     alt="Grilled food">
                <h3>Grilled Special</h3>
                <p>Freshly grilled and full of flavor.</p>
                <h4>₹249</h4>
                <button onclick="alert('Grilled food added to order!')">
                    Order Now
                </button>
            </div>

        </div>
    </section>

    <!-- Customer Reviews -->
    <section id="reviews">
        <h2>Customer Reviews ⭐</h2>
        <div class="review">
            <p>"Very tasty food and fast delivery!"</p>
            <h4>- Rahul</h4>
        </div>

        <div class="review">
            <p>"Affordable prices and excellent service."</p>
            <h4>- Priya</h4>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Foodie | Online Food Ordering Website</p>
    </footer>

</body>
</html>
