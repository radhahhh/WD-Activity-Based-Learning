
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEasy - Online Shopping</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header>
        <h1>🛍️ ShopEasy</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#categories">Categories</a>
            <a href="#products">Products</a>
            <a href="#offers">Offers</a>
        </nav>
        <a href="#products" class="cart">🛒 Cart</a>
    </header>

    <!-- Promotional Banner -->
    <section class="banner" id="home">
        <h2>Big Shopping Sale!</h2>
        <p>Get up to 50% OFF on selected products.</p>
        <a href="#products" class="shop-btn">Shop Now</a>
    </section>

    <!-- Categories -->
    <section id="categories">
        <h2>Shop by Category</h2>
        <div class="categories">
            <a href="#products">👕 Fashion</a>
            <a href="#products">📱 Electronics</a>
            <a href="#products">⌚ Accessories</a>
            <a href="#products">👟 Footwear</a>
        </div>
    </section>

    <!-- Products -->
    <section id="products">
        <h2>Featured Products</h2>

        <div class="product-container">

            <div class="product-card">
                <span class="discount">30% OFF</span>
                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500"
                     alt="Cotton T-shirt">
                <h3>Cotton T-Shirt</h3>
                <p>Comfortable casual wear for everyday use.</p>
                <p class="rating">⭐ 4.5/5</p>
                <h4>₹699 <del>₹999</del></h4>
                <button onclick="alert('T-Shirt added to cart!')">
                    Add to Cart
                </button>
            </div>

            <div class="product-card">
                <span class="discount">20% OFF</span>
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500"
                     alt="Wireless headphones">
                <h3>Headphones</h3>
                <p>Enjoy clear sound with wireless comfort.</p>
                <p class="rating">⭐ 4.3/5</p>
                <h4>₹1,599 <del>₹1,999</del></h4>
                <button onclick="alert('Headphones added to cart!')">
                    Add to Cart
                </button>
            </div>

            <div class="product-card">
                <span class="discount">25% OFF</span>
                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
                     alt="Wristwatch">
                <h3>Wrist Watch</h3>
                <p>A stylish watch for every occasion.</p>
                <p class="rating">⭐ 4.6/5</p>
                <h4>₹1,499 <del>₹1,999</del></h4>
                <button onclick="alert('Watch added to cart!')">
                    Add to Cart
                </button>
            </div>

            <div class="product-card">
                <span class="discount">40% OFF</span>
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500"
                     alt="Red sports shoes">
                <h3>Sports Shoes</h3>
                <p>Lightweight shoes for walking and running.</p>
                <p class="rating">⭐ 4.4/5</p>
                <h4>₹1,799 <del>₹2,999</del></h4>
                <button onclick="alert('Shoes added to cart!')">
                    Add to Cart
                </button>
            </div>

        </div>
    </section>

    <!-- Offer Banner -->
    <section class="offer" id="offers">
        <h2>Special Offer 🎉</h2>
        <p>Get an extra 10% discount on your next purchase!</p>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 ShopEasy | Online Shopping Website</p>
    </footer>

</body>
</html>
